# Viewer works without environment variables. Configure these for admin login.
NEXTAUTH_URL=http://localhost:3000
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Owner: can edit markers and manage editor emails. Never expose with NEXT_PUBLIC_.
SUPER_ADMIN_GOOGLE_EMAIL=
# Optional, comma-separated bootstrap editors; managed separately from UI editors.
ADMIN_GOOGLE_EMAILS=
# Optional: token for your own PRIVATE Vercel Blob store (required on Vercel).
BLOB_READ_WRITE_TOKEN=
# Optional analytics, disabled by default.
NEXT_PUBLIC_ENABLE_ANALYTICS=false
